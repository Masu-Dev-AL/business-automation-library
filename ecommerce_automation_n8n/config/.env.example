# WooCommerce API Configuration
# Get these from: WooCommerce > Settings > Advanced > REST API
WC_URL=http://ecommerce-test.local/wp-json/wc/v3
WC_CONSUMER_KEY=ck_your_consumer_key_here
WC_CONSUMER_SECRET=cs_your_consumer_secret_here

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ecommerce_inventory
DB_USER=postgres
DB_PASSWORD=your_password_here

# Alert Thresholds
LOW_STOCK_THRESHOLD=10
CRITICAL_STOCK_THRESHOLD=5
SLOW_MOVER_THRESHOLD=5

# Notification Settings (configure after setup)
ALERT_EMAIL=inventory-team@company.com
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
