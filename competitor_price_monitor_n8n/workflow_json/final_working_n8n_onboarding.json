        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"url\": \"{{ $('Extract Domain').first().json.url }}\",\n  \"requires_browser\": {{ $('Extract Domain').first().json.requires_browser }},\n  \"allow_llm_fallback\": true,\n  \"vitamin_hint\": \"{{ $('Extract Domain').first().json.vitamin }}\"\n}",
