# ─── n8n ──────────────────────────────────────────────────────────────────────
N8N_HOST=n8n.your-domain.com
TIMEZONE=America/New_York
N8N_ENCRYPTION_KEY=your-random-32-char-string-here

# ─── Anthropic ────────────────────────────────────────────────────────────────
# Used by scraper-api (Haiku fallback) and n8n (Sonnet weekly analysis)
ANTHROPIC_API_KEY=sk-ant-api03-...

# ─── Google ───────────────────────────────────────────────────────────────────
# Configure Google OAuth2 credentials inside n8n (Credentials → New → Google Sheets OAuth2)
# The sheet ID is the long string in your Google Sheet URL:
# https://docs.google.com/spreadsheets/d/SHEET_ID_HERE/edit
VITAMIN_MONITOR_SHEET_ID=your-google-sheet-id-here

# ─── Email ────────────────────────────────────────────────────────────────────
VITAMIN_MONITOR_RECIPIENT=your@email.com
