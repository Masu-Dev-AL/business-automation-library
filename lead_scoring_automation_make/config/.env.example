# ── Typeform ─────────────────────────────────────────────────────────────────
# Public link to your Typeform lead intake form
TYPEFORM_FORM_URL=https://yourworkspace.typeform.com/to/xxxxxxxx

# ── Anthropic ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Airtable ─────────────────────────────────────────────────────────────────
# Personal Access Token — generated in Airtable account settings
AIRTABLE_API_TOKEN=your_airtable_personal_access_token_here
# Found in the URL of your Airtable base: airtable.com/appXXXXXXXXXXXXXX
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX
AIRTABLE_TABLE_NAME=Leads

# ── Slack Webhook URLs ────────────────────────────────────────────────────────
# One incoming webhook URL per territory channel
# Create these in your Slack App settings under "Incoming Webhooks"
SLACK_WEBHOOK_NORTH_AMERICA=https://hooks.slack.com/services/xxx/yyy/zzz
SLACK_WEBHOOK_EUROPE=https://hooks.slack.com/services/xxx/yyy/zzz
SLACK_WEBHOOK_ASIA=https://hooks.slack.com/services/xxx/yyy/zzz
SLACK_WEBHOOK_GENERAL=https://hooks.slack.com/services/xxx/yyy/zzz

# ── Slack Rep Display Names ───────────────────────────────────────────────────
# Used for @mentions in Slack messages — must match the Slack display name exactly
SLACK_REP_NORTH_AMERICA=sarah.mitchell   # @sarah.mitchell
SLACK_REP_EUROPE=james.hartley           # @james.hartley
SLACK_REP_ASIA=priya.chen                # @priya.chen
SLACK_REP_GENERAL=manager                # @manager

# ── Gmail ─────────────────────────────────────────────────────────────────────
# No API key needed — authenticate via Make.com's Gmail connection (OAuth)
# Set the sender name to display in the From field of auto-reply emails
GMAIL_SENDER_NAME=Sales Team
