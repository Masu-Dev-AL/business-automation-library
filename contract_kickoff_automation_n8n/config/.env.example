# ── DocuSign ─────────────────────────────────────────────────────────────────
# DocuSign account ID — found in your DocuSign developer/admin console
DOCUSIGN_ACCOUNT_ID=your_docusign_account_id_here

# DocuSign integration key (OAuth2 client ID) — from your app in DocuSign developer portal
DOCUSIGN_OAUTH_CLIENT_ID=your_docusign_integration_key_here

# DocuSign OAuth2 secret key
DOCUSIGN_OAUTH_CLIENT_SECRET=your_docusign_oauth_secret_here

# ── Anthropic / Claude ────────────────────────────────────────────────────────
# Claude API key — used in the Analyze Document node (extraction) and A11 (kickoff email draft)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Asana ────────────────────────────────────────────────────────────────────
# Asana personal access token or OAuth token
ASANA_ACCESS_TOKEN=your_asana_access_token_here

# Asana workspace GID — find in your Asana URL: app.asana.com/0/{WORKSPACE_GID}/...
ASANA_WORKSPACE_GID=your_asana_workspace_gid_here

# Asana team GID — find via GET https://app.asana.com/api/1.0/teams
ASANA_TEAM_GID=your_asana_team_gid_here

# ── Email ─────────────────────────────────────────────────────────────────────
# Email address for operator failure alerts (node A15)
OPERATOR_EMAIL=your_operator_email@example.com

# CC'd on all kickoff emails sent to clients (node A12)
ACCOUNT_MANAGER_EMAIL=your_account_manager@example.com

# Plain text signature block appended to kickoff emails
EMAIL_SIGNATURE="Best,\nYour Name\nYour Company\nyour@email.com"

# ── Phase 3: Alternative PM Tools (add when needed) ─────────────────────────
# ClickUp API key and list ID for task creation
CLICKUP_API_KEY=your_clickup_api_key_here
CLICKUP_LIST_ID=your_clickup_list_id_here

# Notion database ID for page creation
NOTION_DATABASE_ID=your_notion_database_id_here
